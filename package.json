{
  "name": "quantajs",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" dev",
    "build": "pnpm --filter \"./packages/**\" build",
    "preview": "pnpm --filter \"./packages/**\" preview",
    "clean": "pnpm --filter \"./packages/**\" clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "pnpm --filter \"./packages/**\" test:types",
    "bench": "node benchmarks/compare.mjs",
    "lint": "pnpm --filter \"./packages/**\" lint",
    "lint:fix": "pnpm --filter \"./packages/**\" lint:fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "changeset": "changeset",
    "version:update": "pnpm changeset version && pnpm install",
    "publish": "pnpm build && pnpm changeset publish",
    "examples:build": "pnpm --filter \"./examples/**\" build",
    "examples:verify": "pnpm --filter \"./examples/**\" verify",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "verify:readme": "node scripts/verify-readme-snippets.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-banner": "^0.8.1",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
