        "@quantajs/astro": "workspace:*",
        "@quantajs/core": "workspace:*",
        "@quantajs/react": "workspace:*",
        "@quantajs/svelte": "workspace:*",
        "@quantajs/vue": "workspace:*",
        "astro": "^7.3.5",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "svelte": "^5.46.4",
        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
