---
import { ClientRouter } from 'astro:transitions';

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <!-- Each page's state is applied on navigation too. -->
        <ClientRouter />
    </head>
    <body>
        <nav>
            <a href="/?user=guest">Per-request page</a>
            <a href="/static">Prerendered page</a>
        </nav>
        <slot />
    </body>
</html>
