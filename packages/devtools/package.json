{
    "name": "@quantajs/devtools",
    "private": false,
    "author": {
        "name": "Jeel Gajera",
        "url": "https://github.com/JeelGajera"
    },
    "description": "In-page state inspector for QuantaJS stores.",
    "keywords": [
        "quantajs",
        "devtools",
        "state-management",
        "debugging"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quanta-js/quanta.git",
        "directory": "packages/devtools"
    },
    "bugs": {
        "url": "https://github.com/quanta-js/quanta/issues"
    },
    "homepage": "https://quantajs.com/docs/guides/devtools",
    "version": "3.0.0",
    "type": "module",
    "license": "MIT",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test:types": "tsc --noEmit",
        "dev": "vite",
        "build": "npm run clean && vite build && npm run build:types",
        "clean": "rimraf dist",
        "lint": "eslint . --ext .ts,.tsx",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "build:types": "tsc -p tsconfig.build.json"
    },
    "peerDependencies": {
        "@quantajs/core": "workspace:*"
    },
    "dependencies": {
        "preact": "^10.29.8"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.6",
        "@quantajs/core": "workspace:*"
    },
    "files": [
        "dist"
    ]
}
