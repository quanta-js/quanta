{
    "name": "@quantajs/core",
    "private": false,
    "author": {
        "name": "Jeel Gajera",
        "url": "https://github.com/JeelGajera"
    },
    "description": "Framework-agnostic reactive stores with request-scoped containers, async action state and persistence. No runtime dependencies.",
    "keywords": [
        "quantajs",
        "state-management",
        "store",
        "reactivity",
        "reactive",
        "proxy",
        "ssr",
        "persistence",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quanta-js/quanta.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/quanta-js/quanta/issues"
    },
    "homepage": "https://quantajs.com",
    "version": "3.0.0",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "test:types": "tsc --noEmit",
        "dev": "npm run format && npm run lint:fix && npm run build",
        "build": "npm run clean && vite build && npm run build:types",
        "preview": "vite preview",
        "clean": "rimraf dist",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
        "build:types": "tsc -p tsconfig.build.json"
    },
    "devDependencies": {},
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false
}
