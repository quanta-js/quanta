{
    "name": "@quantajs/react",
    "private": false,
    "author": {
        "name": "Jeel Gajera",
        "url": "https://github.com/JeelGajera"
    },
    "description": "React integration for QuantaJS - A compact, scalable, and developer-friendly state management library for React applications.",
    "keywords": [
        "quantajs",
        "quanta",
        "state-management",
        "reactivity",
        "react",
        "hooks"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/quanta-js/quanta.git"
    },
    "bugs": {
        "url": "https://github.com/quanta-js/quanta/issues"
    },
    "homepage": "https://quantajs.com",
    "version": "2.1.0",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "test:types": "tsc --noEmit",
        "dev": "npm run format && npm run lint:fix && npm run build",
        "build": "npm run clean && vite build && npm run build:types",
        "preview": "vite preview",
        "clean": "rimraf dist",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\"",
        "build:types": "tsc -p tsconfig.build.json"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "peerDependencies": {
        "react": ">=18.0.0",
        "@quantajs/devtools": ">=2.0.0"
    },
    "dependencies": {
        "@quantajs/core": "workspace:*"
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.4",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "@quantajs/devtools": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@quantajs/devtools": {
            "optional": true
        }
    }
}
